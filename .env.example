# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=student_management

# Flask Session Secret Key
SECRET_KEY=your_secret_key_here

# Debug mode — set to true ONLY for local development; always false for any real deployment
FLASK_DEBUG=false

# Public Base URL for ID Card QR verification scans (e.g. https://studentmanagement.vercel.app or http://192.168.1.100:5000)
# Configure this in production so smartphone camera QR scans open the verification URL from anywhere.
PUBLIC_BASE_URL=https://your-domain.vercel.app

# Optional Email Configuration (Flask-Mail) — app functions normally if unset
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_DEFAULT_SENDER=noreply@yourinstitution.edu

# Optional User Seeding Passwords (used when running seed_users.py in production)
# SEED_ADMIN_PASSWORD=your_secure_admin_password
# SEED_TEACHER_PASSWORD=your_secure_teacher_password
# SEED_STUDENT_PASSWORD=your_secure_student_password
# Set to true only in development/demo setup to allow default credentials (admin123/teacher123/student123):
SEED_ALLOW_DEMO=false

