# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=student_management

# Flask Session Secret Key
SECRET_KEY=your_secret_key_here

# Debug mode — set to true ONLY for local development; always false for any real deployment
FLASK_DEBUG=false

# Optional Email Configuration (Flask-Mail) — app functions normally if unset
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password
# MAIL_DEFAULT_SENDER=noreply@yourinstitution.edu
